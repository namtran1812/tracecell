{
  "name": "tracecell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "node --test $(find dist/tests -type f -name '*.test.js' | sort)",
    "dev": "tsx src/index.ts",
    "demo:async": "tsx src/async-demo.ts",
    "build:infra": "npm --prefix infrastructure run build",
    "synth": "npm run build && npm run build:infra && npm --prefix infrastructure run synth",
    "build:web": "npm --prefix apps/web run build",
    "dev:web": "npm --prefix apps/web run dev",
    "benchmark": "npm run build && node dist/src/benchmark/run.js",
    "benchmark:quick": "npm run build && TRACECELL_TRACE_COUNT=10000 TRACECELL_REQUEST_COUNT=250 node dist/src/benchmark/run.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "@types/aws-lambda": "^8.10.152"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.879.0",
    "@aws-sdk/client-s3": "^3.879.0"
  }
}
